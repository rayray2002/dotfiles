# ssh client config, symlinked to ~/.ssh/config by modules/ssh.nix.
# Edit here, then: dots-sync
#
# ssh keeps the FIRST value it finds for each option, so order matters:
#   * a `Match ... exec` probe goes before the `Host` block that is its fallback
#   * `Host *` defaults go last, so any host above can override them
#
# Multi-route hosts (LAN -> Tailscale -> school/jump) get HostName, ProxyJump
# and HostKeyAlias from ~/.ssh/routes.conf, generated from ssh/routes.nix by
# modules/ssh.nix. Only User and other per-host options live here.

Include ~/.ssh/routes.conf

# ---------------------------------------------------------------------------
# USC lab
# ---------------------------------------------------------------------------

# xarm, a.k.a. salep (its tailnet name)
Host xarm salep
  User ray

# snoopy1.usc.edu (rootless userspace tailscaled under systemd --user)
Host snoopy
  User borueihu

# Franka/Panda workstation (tailnet name: glamor-citrine)
Host glamor_panda_shared
  User franka_glamor
Host glamor_panda_ray
  User ray

# ---------------------------------------------------------------------------
# Personal
# ---------------------------------------------------------------------------

Host ray-desktop
  User ray
  Compression yes

# this mac, over the tailnet (needs Remote Login in System Settings > Sharing)
Host mac
  User ray
  HostName 100.78.144.98

Host hrimfaxi
  User ray
  HostName 100.67.150.118

# ---------------------------------------------------------------------------
# Legacy school accounts
# ---------------------------------------------------------------------------

# NTU CSIE workstations, e.g. `ssh linux1` -> linux1.csie.ntu.edu.tw
Host linux* oasis* meow* ws*
  HostName %h.csie.ntu.edu.tw
  User b09901171

# Caltech GPS, e.g. `ssh foo.gps` -> foo.gps.caltech.edu
Host *.gps
  HostName %h.caltech.edu
  User brh

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

# X11 (XQuartz) only to machines we run GUIs on. Trusted mode is needed by
# OpenGL apps like rviz, but it gives the remote full access to the local X
# display, so it is not handed to every host (GitHub included).
Host xarm salep snoopy glamor_panda_shared glamor_panda_ray ray-desktop hrimfaxi
  ForwardX11 yes
  ForwardX11Trusted yes

# No ForwardAgent: remote hosts carry their own GitHub keys, and a forwarded
# agent lets anyone with root there use ours. Enable per host if ever needed.
Host *
  ServerAliveInterval 15
  ServerAliveCountMax 4
