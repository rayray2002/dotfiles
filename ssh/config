# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

# X11 (XQuartz) only to machines we run GUIs on. Trusted mode is needed by
# OpenGL apps like rviz, but it gives the remote full access to the local X
# display, so it is not handed to every host (GitHub included).
Host xarm salep snoopy glamor_panda_shared glamor_panda_ray ray-desktop hrimfaxi
  ForwardX11 yes
  ForwardX11Trusted yes

# No ForwardAgent: remote hosts carry their own GitHub keys, and a forwarded
# agent lets anyone with root there use ours. Enable per host if ever needed.
Host *
  ServerAliveInterval 15
  ServerAliveCountMax 4
  # pinned keys (read-only, from dotfiles) + local file that ssh appends to
  UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts.d/dotfiles
  # unlock a passphrase-protected key once and keep it in the agent; the
  # passphrase lives in the macOS Keychain (Linux ssh ignores UseKeychain)
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  # Reuse one connection per host for 10 min after the last session closes:
  # repeated ssh/scp/git/dots-sync skip the handshake (two of them through a
  # jump host). %C hashes the resolved address, so a new route after a network
  # change gets a fresh connection. `ssh-drop` closes them all.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 10m
