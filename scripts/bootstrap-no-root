#!/usr/bin/env bash
# Set up Nix + this home-manager config on a Linux machine where you have no
# root, the way snoopy runs (see modules/no-root.nix): nix-portable keeps the
# store under noRoot.location, home-manager activates into noRoot.home, and the
# real home is left alone apart from a hook at the top of ~/.zshrc.
#
#   scripts/bootstrap-no-root <user@alias>
#
# The machine must be in hosts.nix with noRoot set. Safe to re-run.
set -euo pipefail

target=${1:?usage: $0 <user@alias>   (flake target from hosts.nix)}
alias=${target#*@}
repo=$(cd "$(dirname "$0")/.." && pwd)
np_version=v012

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
die() { printf 'bootstrap-no-root: %s\n' "$*" >&2; exit 1; }

# noRoot.<key> for this host, read from hosts.nix without needing Nix yet.
field() {
  awk -v a="$alias" -v k="$1" '
    $1 == a { inhost = 1; next }
    inhost && /^  [A-Za-z0-9_-]+ +=/ { exit }
    inhost && $1 == k { match($0, /"[^"]+"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }
  ' "$repo/hosts.nix"
}

[[ $(uname -s) == Linux ]] || die "Linux only"
unshare --user --map-root-user true 2>/dev/null ||
  die "unprivileged user namespaces are disabled here, so nix-portable can't run"
loc=$(field location); home=$(field home); flake=$(field flake)
[[ -n $loc && -n $home && -n $flake ]] || die "hosts.nix: '$alias' needs noRoot.{location,home,flake}"
bin=$loc/bin

say "nix-portable $np_version -> $bin/nix-portable"
mkdir -p "$bin" "$home"
if [[ ! -x $bin/nix-portable ]]; then
  curl -fL -o "$bin/nix-portable.tmp" \
    "https://github.com/DavHau/nix-portable/releases/download/$np_version/nix-portable-$(uname -m)"
  chmod 755 "$bin/nix-portable.tmp" && mv "$bin/nix-portable.tmp" "$bin/nix-portable"
fi

say "dotfiles checkout -> $flake"
if [[ ! -d $flake/.git ]]; then
  git clone https://github.com/rayray2002/dotfiles.git "$flake"
fi
[[ $(git -C "$flake" branch --show-current) == main ]] || die "$flake must be on main"

# Same steps as the generated hm-switch, which doesn't exist until this first
# activation writes it.
say "building and activating $target (first run downloads a few GB)"
export NP_LOCATION=$loc NP_RUNTIME=bwrap HOME=$home
gen=$("$bin/nix-portable" nix build "$flake#homeConfigurations.\"$target\".activationPackage" \
  --no-link --print-out-paths --extra-experimental-features 'nix-command flakes')
v=$("$bin/nix-portable" nix --version | awk '{print $NF}')
# shellcheck disable=SC2016  # expanded by the inner bash
"$bin/nix-portable" nix shell nixpkgs#bash --command bash -c '
  export PATH="$(echo /nix/store/*-nix-'"$v"'/bin):$PATH"
  exec bash "$1"
' hm "$gen/activate"

real_zshrc=$(getent passwd "$(id -un)" | cut -d: -f6)/.zshrc
if ! grep -qs 'bin/nixshell' "$real_zshrc"; then
  say "adding the nixshell hook to the top of $real_zshrc (backup: .zshrc.pre-dotfiles)"
  [[ -e $real_zshrc ]] && cp -p "$real_zshrc" "$real_zshrc.pre-dotfiles"
  {
    cat <<EOF
# Enter the rootless home-manager env (dotfiles: modules/no-root.nix) on
# interactive logins. Skipped inside it, with NO_NIXSHELL=1, or if the store
# is missing, so this can't lock you out. Plain shell: NO_NIXSHELL=1 zsh
if [[ -o interactive && -z \$IN_NIXSHELL && -z \$NO_NIXSHELL \\
      && -x $bin/nixshell && -d $loc/.nix-portable ]]; then
  exec $bin/nixshell
fi

EOF
    [[ -e $real_zshrc.pre-dotfiles ]] && cat "$real_zshrc.pre-dotfiles"
  } > "$real_zshrc"
fi

say "Done. Open a new ssh session; it lands in the env (HOME=$home)."
