#compdef dots-secret
# Completion for dots-secret (modules/secrets.nix): subcommands, then secret names.
local -a cmds
cmds=(
  'init-host:make this machine'\''s age key and print its public key'
  'list:list the secrets in the repo'
  'set:encrypt stdin as secrets/NAME.age'
  'edit:decrypt, edit in $EDITOR, re-encrypt'
  'rekey:re-encrypt every secret to the current recipients'
)
if (( CURRENT == 2 )); then
  _describe -t commands 'dots-secret command' cmds
elif (( CURRENT == 3 )) && [[ $words[2] == (edit|set) ]]; then
  local -a names=( ${(f)"$(dots-secret list 2>/dev/null)"} )
  _wanted secrets expl 'secret' compadd -a names
fi
