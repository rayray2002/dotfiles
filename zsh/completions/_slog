#compdef slog
# Completion for slog (modules/slurm.nix): your jobs, newest first, with names and state.
local -a jobs
jobs=( ${(f)"$(squeue -h -u $USER --sort=-V -o '%i:%j (%T, %M)' 2>/dev/null)"}
       ${(f)"$(sacct -u $USER -S now-2days -X -n -P -o JobID,JobName,State 2>/dev/null | awk -F'|' '{print $1 ":" $2 " (" $3 ")"}')"} )
(( CURRENT == 2 )) && _describe -t jobs 'job' jobs
